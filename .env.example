REDPANDA_BROKERS=localhost:9092
INTERNAL_REDPANDA_BROKERS=soc-redpanda:29092
LOG_LEVEL=INFO
MAX_EVENT_SIZE_MB=5
ENVIRONMENT=development
UI_PORT=8501
# Auto-generated secrets for docker-compose
COMPOSE_POSTGRES_USER=soc_admin
COMPOSE_POSTGRES_PASSWORD=INJECT_VIA_SECRET_MANAGER

# --- Required by api/, shared/, inference/ -- previously undocumented ---
# here, so nothing in the local Quickstart flow could start without first
# reading source to discover which env vars it silently required.
DATABASE_URL=postgresql://soc_admin:INJECT_VIA_SECRET_MANAGER@localhost:5432/tsoc
TSOC_API_KEY=INJECT_VIA_SECRET_MANAGER
# api/kafka_sink.py: this tenant's own ingest credential, minted via
# POST /api/v1/ingest/tenants/{id}/sensor-tokens (admin-only) -- NOT the
# same as TSOC_API_KEY above. kafka_sink no longer writes to Postgres
# directly; it POSTs each batch to /api/v1/ingest/alerts, authenticated
# as one tenant's sensor rather than as a blanket internal service.
TSOC_SENSOR_TOKEN=INJECT_VIA_SECRET_MANAGER
# Where api/kafka_sink.py sends ingested alerts -- defaults to the same
# local API URL dashboard/terminal use (http://127.0.0.1:8000/api/v1).
# INGEST_API_URL=http://127.0.0.1:8000/api/v1
# Must be >=32 bytes for HS256 (RFC 7518 Section 3.2) -- PyJWT warns
# (InsecureKeyLengthWarning) if it's shorter. e.g.: openssl rand -hex 32
TSOC_JWT_SECRET=INJECT_VIA_SECRET_MANAGER
REDIS_PASSWORD=INJECT_VIA_SECRET_MANAGER
# true by default (api/deps.py, inference/correlation.py); set to false
# only for a local dev broker with TLS disabled (docker-compose.yml's
# redis service is TLS-only, matching this default).
REDIS_SSL=true
# docker-compose.yml's redis service enforces mutual TLS
# (--tls-auth-clients yes) -- all three of these are required to connect
# to it at all (not just "optional" the way the code's own fallback
# defaults treat them for other, non-mTLS-enforcing deployments).
# scripts/generate_dev_certs.sh generates all three into ./certs.
REDIS_CA_CERT_PATH=./certs/ca.crt
REDIS_CLIENT_CERT_PATH=./certs/client.crt
REDIS_CLIENT_KEY_PATH=./certs/client.key

# --- Optional, sane defaults already applied in code if unset ---
# api/email.py: invite/password-reset links are logged (not emailed) when
# SMTP_HOST is unset -- fine for local dev, not for real employees. Any
# provider that speaks SMTP works (SES, Postmark, SendGrid, Mailgun, or a
# company's own relay); set these four to actually deliver.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=INJECT_VIA_SECRET_MANAGER
# SMTP_FROM_ADDRESS=T-SOC <no-reply@tsoc.example>
# SMTP_USE_TLS=true   # false only for a trusted internal relay with no TLS
# API_URL=https://api.tsoc.local/api/v1     # dashboard's backend base URL
# DB_SSLMODE=verify-full   # for postgresql:// URLs, must be require/verify-ca/verify-full -- api/database.py fails to boot on disable/allow/prefer
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,10.244.0.0/16
# TSOC_CORS_ORIGINS=https://dashboard.tsoc.local
# TSOC_CORS_STRICT=0
# ENABLE_DOCS=false
# TSOC_JWT_EXPIRY_MIN=30
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # unset = tracing is a real no-op; see docker-compose.yml's jaeger service
# METRICS_PORT=9101   # api/kafka_sink.py's prometheus_client HTTP server port
# DASHBOARD_PASSWORD=   # login is mandatory regardless; unset = defaults to "user"/"user" (fine for local testing, set a real one before anyone else can reach this)
# JA4_RELOAD_INTERVAL_SEC=60   # inference/rules.py re-reads JA4_MALICIOUS_FINGERPRINTS from env on this TTL, no restart needed
# JA4_MALICIOUS_FINGERPRINTS=t13d000000_rare_fingerprint   # comma-separated; default is only the demo injector's synthetic value
