# Example secrets template — DO NOT COMMIT REAL VALUES
# Copy to k8s/secrets.yaml (gitignored) and populate via vault/CI
apiVersion: v1
kind: Secret
metadata:
  name: tsoc-secrets
type: Opaque
stringData:
  slack_webhook_url: "REPLACE_ME_VIA_VAULT"
  pagerduty_routing_key: "REPLACE_ME_VIA_VAULT"
  redis_password: "REPLACE_ME_VIA_VAULT"
  api_key: "REPLACE_ME_VIA_VAULT"
  # Backs every per-employee login session (api/routes/auth.py) -- >=32
  # bytes for HS256 (RFC 7518 Section 3.2), e.g.: openssl rand -hex 32
  jwt_secret: "REPLACE_ME_VIA_VAULT"
  # api/kafka_sink.py's per-tenant ingest credential -- minted via
  # POST /api/v1/ingest/tenants/{id}/sensor-tokens (admin-only), NOT
  # generated ahead of time like the other values here. Populate this
  # key after that tenant/admin/token bootstrap step, not before.
  sensor_token: "REPLACE_ME_VIA_VAULT"
  # Both the user and password below are the same placeholder as every
  # other field in this file — unlike "soc_admin:CHANGE_ME", nothing here
  # looks like a value someone could ship as-is.
  DATABASE_URL: "postgresql://REPLACE_ME_VIA_VAULT:REPLACE_ME_VIA_VAULT@postgres:5432/tsoc?sslmode=verify-full"
  # api/email.py: without this, invite/password-reset links are only
  # ever logged, never actually emailed -- fine for a demo, not for real
  # employees. Any SMTP-speaking provider works (SES, Postmark,
  # SendGrid, Mailgun, or a company's own relay).
  smtp_password: "REPLACE_ME_VIA_VAULT"
# Use SealedSecret or Vault — do not commit raw secrets
