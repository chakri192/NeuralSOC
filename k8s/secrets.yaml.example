# Example secrets template — DO NOT COMMIT REAL VALUES
# Copy to k8s/secrets.yaml (gitignored) and populate via vault/CI
apiVersion: v1
kind: Secret
metadata:
  name: tsoc-secrets
type: Opaque
stringData:
  slack_webhook_url: "https://hooks.slack.com/services/CHANGE_ME"
  pagerduty_routing_key: "CHANGE_ME"
  redis_password: "CHANGE_ME_STRONG_32BYTE"
  api_key: "CHANGE_ME_APITOKEN"
  DATABASE_URL: "postgresql://soc_admin:CHANGE_ME@postgres:5432/tsoc"
